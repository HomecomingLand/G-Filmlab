---
import type { CollectionEntry } from 'astro:content';
import TitleCard from './TitleCard.astro';
import { courseUrl } from '../i18n';
import { statusLabel } from '../lib/courses';
interface Props { course: CollectionEntry<'courses'>; index: number }
const { course, index } = Astro.props;
const d = course.data;
const href = courseUrl(course.id);
---
<article class="cc">
  <a href={href} class="cc__media" tabindex="-1" aria-hidden="true">
    {d.image
      ? <div class="frame frame--4x3"><img src={d.image} alt="" loading="lazy" /></div>
      : <TitleCard title={d.title} format={d.format} index={index} />}
  </a>
  <p class="eyebrow cc__meta"><span>{d.format}</span>{d.status !== 'open' && <span class="cc__status">{statusLabel[d.status]}</span>}</p>
  <h3 class="display-sm"><a href={href}>{d.title}</a></h3>
  <p class="cc__sum">{d.summary}</p>
  <a class="arrow-link" href={href}>Ontdek de cursus</a>
</article>
<style>
  .cc { display: flex; flex-direction: column; }
  .cc__media { display: block; overflow: hidden; }
  .cc__media :global(img), .cc__media :global(.tc) { transition: transform 0.6s ease; }
  .cc:hover .cc__media :global(img), .cc:hover .cc__media :global(.tc) { transform: scale(1.025); }
  .cc__meta { font-family: var(--font-script); font-weight: 400; letter-spacing: 0.04em; margin: 1.3rem 0 0.6rem; color: var(--ink-soft); display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .cc__status { color: var(--red); }
  .cc h3 a:hover { color: var(--red); }
  .cc__sum { margin: 0.8rem 0 1.2rem; flex: 1; }
  @media (prefers-reduced-motion: reduce) { .cc__media :global(img), .cc__media :global(.tc) { transition: none; } }
</style>
